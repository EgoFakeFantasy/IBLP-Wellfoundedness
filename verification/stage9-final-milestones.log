IBLP.boundedCutAction_restriction.{u} {alpha beta delta epsilon : Ordinal.{u}} (ha : Order.IsSuccLimit alpha)
  (hd : Order.IsSuccLimit delta) (k : IBLP.BoundedMap alpha beta) (small : IBLP.BoundedMap delta epsilon)
  (h : delta ≤ alpha) (agree : ∀ (x : RankDomain (Order.succ delta)), ↑(small x) = ↑(k (IBLP.rankInclude ⋯ x))) :
  IBLP.CutRestriction (IBLP.boundedCutAction hd small) (IBLP.boundedCutAction ha k)
