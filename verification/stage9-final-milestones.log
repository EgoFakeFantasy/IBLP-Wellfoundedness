  IBLP.modelGraphCriticalPointFormula.Realize ![graph, critical] ↔ M.GraphCriticalPoint graph critical
IBLP.ModelStage.graphWeakAgreement_image.{u} (source target : IBLP.ModelStage)
  (j : source.model.ElementaryMap target.model) (f g : source.model.Element) (alpha gamma delta : Ordinal.{u}) :
  target.model.GraphWeakAgreement (j f) (j g) (target.hierarchy (source.ordinalImage j alpha))
      (target.hierarchy (source.ordinalImage j gamma)) (target.hierarchy (source.ordinalImage j delta)) ↔
    source.model.GraphWeakAgreement f g (source.hierarchy alpha) (source.hierarchy gamma) (source.hierarchy delta)
