  IBLP.InternalTraceRows stage a (IBLP.finiteThetaExtension theta)
IBLP.FactorTrace.carrier_bound.{u} {stage : IBLP.ModelStage} {a : IBLP.Pattern} {theta : ℕ → Ordinal.{u}}
  (R : IBLP.InternalTraceRows stage a theta) {target start : ℕ} {rows : List ℕ}
  (h : IBLP.FactorTrace a target start rows) {carrier : ℕ}
  (increasing : StrictMonoOn theta (Set.Iic (List.length a + 1))) (inside : carrier ≤ List.length a)
  (earlier : start < carrier) :
  theta start < (IBLP.FactorTrace.word R.actions h).bound ∧
    (IBLP.FactorTrace.word R.actions h).bound ≤ theta (start + 1) ∧ theta (start + 1) < theta (carrier + 1)
IBLP.FactorTrace.markCertificate_iff_allInputs.{u} {stage : IBLP.ModelStage} {a : IBLP.Pattern}
  {theta : ℕ → Ordinal.{u}} (R : IBLP.InternalTraceRows stage a theta) {target start : ℕ} {rows : List ℕ}
  (h : IBLP.FactorTrace a target start rows) (carrier : ℕ) :
  IBLP.FactorTrace.MarkCertificate R h carrier ↔
    (R.actions.action carrier).AllInputAgreement (IBLP.FactorTrace.word R.actions h)
      (IBLP.FactorTrace.word R.actions h).bound
IBLP.FactorTrace.markCertificate_reads_predecessor.{u} {stage : IBLP.ModelStage} {a : IBLP.Pattern}
  {theta : ℕ → Ordinal.{u}} (R : IBLP.InternalTraceRows stage a theta) {target start : ℕ} {rows : List ℕ}
  (h : IBLP.FactorTrace a target start rows) {carrier : ℕ}
  (certificate : IBLP.FactorTrace.MarkCertificate R h carrier) :
  stage.weakAction (R.map carrier) (stage.ordinal (theta target)) = stage.ordinal (theta start)
