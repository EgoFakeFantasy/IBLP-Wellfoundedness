  (ha : Order.IsSuccLimit alpha) (graph : stage.model.Element) (k : stage.BoundedMap alpha beta)
  (represents : stage.RepresentsBoundedMap graph k) (delta : Ordinal.{u}) (included : delta ≤ alpha) :
  stage.InternalGraphElementary delta (stage.rho k delta)
    (stage.boundedRestrictionGraph graph k represents delta included)
IBLP.exists_initial_root_realization_of_i3.{u} (h : IBLP.I3) :
  ∃ lambda,
    ∃ (hl : Order.IsSuccLimit lambda),
      ∃ theta graphs,
        IBLP.RootGraphRealization hl theta graphs ∧
          (∀ (i : ℕ), IBLP.initialStage.model.InternalInaccessible (IBLP.initialStage.ordinal ↑(theta i))) ∧
            ∀ (r : ℕ) (row : IBLP.Row) (e : ℕ),
              IBLP.rowAt IBLP.root r = some row →
                row.e = some e →
                  IBLP.initialStage.InternalGraphElementary (↑(theta e)) (↑(theta (r + 1)))
                    (IBLP.initialElement ↑(graphs r))
