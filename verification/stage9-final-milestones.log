IBLP.BoundedRealization.mark_internal_realization.{u} {stage : IBLP.ModelStage} {a : IBLP.Pattern}
  (R : IBLP.BoundedRealization stage a) {r b : ℕ} {row : IBLP.Row} (hr : IBLP.rowAt a r = some row)
  (hb : b ∈ row.marks) :
  ∃ target trace,
    row.columns[List.idxOf b row.columns - row.step]? = some target ∧
      IBLP.markTrace a r b = some trace ∧
        ∃ (h : IBLP.FactorTrace a target b trace.dropLast),
          ∃ graph,
            stage.InternalGraphElementary
                (IBLP.FactorTrace.inputBound R.data.toFiniteTraceRows.toInternalTraceRows.actions h)
                (IBLP.FactorTrace.word R.data.toFiniteTraceRows.toInternalTraceRows.actions h).bound graph ∧
              stage.model.InternalInaccessible
                  (stage.ordinal (IBLP.FactorTrace.word R.data.toFiniteTraceRows.toInternalTraceRows.actions h).bound) ∧
                (R.data.point target).toZFSet.pair (R.data.point b).toZFSet ∈ ↑graph ∧
                  (IBLP.FactorTrace.inputBound R.data.toFiniteTraceRows.toInternalTraceRows.actions h).toZFSet.pair
                        (IBLP.FactorTrace.word R.data.toFiniteTraceRows.toInternalTraceRows.actions h).bound.toZFSet ∈
                      ↑graph ∧
                    R.data.point b <
                        (IBLP.FactorTrace.word R.data.toFiniteTraceRows.toInternalTraceRows.actions h).bound ∧
                      (IBLP.FactorTrace.word R.data.toFiniteTraceRows.toInternalTraceRows.actions h).bound ≤
                          R.data.point (b + 1) ∧
                        R.data.point (b + 1) < R.data.point (r + 1) ∧
                          IBLP.FactorTrace.MarkCertificate R.data.toFiniteTraceRows.toInternalTraceRows h r
IBLP.FiniteBoundedData.markRealized_iff_formula.{u} {stage : IBLP.ModelStage} {a : IBLP.Pattern}
  (D : IBLP.FiniteBoundedData stage a) (r : IBLP.FiniteRowIndex a) (row : IBLP.Row) (b : ℕ) :
  D.MarkRealized (↑r) row b ↔
    ∃ target trace,
      row.columns[List.idxOf b row.columns - row.step]? = some target ∧
        IBLP.markTrace a (↑r) b = some trace ∧
          ∃ (h : IBLP.FactorTrace a target b trace.dropLast),
            IBLP.modelWeakAgreementFormula.Realize (D.markFormulaParameters r h)
